FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY auth.mjs oidc.mjs identity-directory.mjs control-plane.mjs control-server.mjs core-adapter.mjs core-checkouts.mjs core-order-client.mjs core-events.mjs events.mjs mcp.mjs staff-pages.mjs quote-binding.mjs checkout-pages.mjs core-media.mjs staff-api.mjs native-staff.mjs request-limits.mjs ./
USER node
ENV PORT=18789 BIND_ADDRESS=0.0.0.0
EXPOSE 18789
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 CMD node -e "const h=require('http');const r=h.get({hostname:'127.0.0.1',port:process.env.PORT,path:'/health',headers:{host:new URL(process.env.CORE_PUBLIC_BASE_URL).host}},x=>{x.resume();process.exitCode=x.statusCode===200?0:1});r.setTimeout(3000,()=>r.destroy());r.on('error',()=>{process.exitCode=1})"
CMD ["node","control-server.mjs"]
