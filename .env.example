# Copy to .env and edit locally. Never commit real credentials.
ASTRACALLS_IMAGE=astracalls-translation:0.3.0
ASTRACALLS_VERSION=0.3.0
POSTGRES_IMAGE=postgres:16-bookworm
OPENAI_API_KEY=
WACALLS_API_KEY=replace_with_a_long_random_app_key
# Optional official Meta accounts: stable base64-encoded random 32-byte key.
# init-env.sh generates this for new installs. Back it up with the database;
# never rotate or remove it while encrypted Meta credentials are stored.
WACALLS_META_ENCRYPTION_KEY=
# Use a URL-safe password (letters/numbers) for the Postgres connection URL.
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
# Local browser testing: 127.0.0.1. Remote deployment: reachable server IP.
WACALLS_PUBLIC_IP=127.0.0.1
WACALLS_UDP_PORT=50000
WACALLS_MEDIA_BIND=127.0.0.1
WACALLS_PUBLIC_BASE_URL=
# HTTP is bound to localhost by default; use an HTTPS reverse proxy remotely.
WACALLS_HTTP_BIND=127.0.0.1
WACALLS_HTTP_PORT=8080
